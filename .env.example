# --- LLM (Gemini free tier) ---
GEMINI_API_KEY=
GEMINI_MODEL=                  # a Flash model from your AI Studio quota page
LLM_REQUESTS_PER_MINUTE=       # set below your real quota
LLM_CACHE_PATH=data/llm_cache

# --- Data ---
DATA_DIR=data
PROCESSED_DIR=data/processed
RANDOM_SEED=42

# --- Chunking and embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_MAX_WORDS=180
CHUNK_OVERLAP_SENTENCES=1

# --- Vector store (embedded Chroma for now) ---
CHROMA_MODE=embedded           # embedded now, server later
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=finqa_chunks

# --- Retrieval and agent ---
RETRIEVAL_TOP_K=5
AGENT_MAX_STEPS=6

# --- Later: add when Postgres and Docker arrive ---
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# CHROMA_HOST=localhost
# CHROMA_PORT=8000